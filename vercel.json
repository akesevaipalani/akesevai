{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && node api/_prepare.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/ssr-seo.js": {
      "includeFiles": "api/_template/index.html"
    }
  },
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(self)" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "has": [
        { "type": "host", "value": "www.akesevai.com" }
      ],
      "destination": "https://akesevai.onrender.com/api/:path*"
    },
    {
      "source": "/api/:path*",
      "has": [
        { "type": "host", "value": "akesevai.com" }
      ],
      "destination": "https://akesevai.onrender.com/api/:path*"
    },
    {
      "source": "/api/(.*)",
      "has": [
        { "type": "host", "value": "www.akesevai.com" }
      ],
      "destination": "https://akesevai.onrender.com/api/$1"
    },
    {
      "source": "/api/(.*)",
      "has": [
        { "type": "host", "value": "akesevai.com" }
      ],
      "destination": "https://akesevai.onrender.com/api/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/ssr-seo"
    },
    {
      "source": "/(.*)",
      "destination": "/api/ssr-seo?__ssr_path=/$1"
    }
  ]
}
